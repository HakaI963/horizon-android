<?xml version="1.0" encoding="utf-8"?>
<!--
    API 33 adds the themed-icon layer: the system recolours the monochrome shape
    to the user's palette, so it is the H alone with no sun (a second block that
    close to the right bar fuses into one silhouette at status-bar size).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
