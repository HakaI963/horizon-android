<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Edge to edge, no bars: a game draws over the whole panel. The cutout item
        is read from API 28 up and ignored below it, which is why minSdk can stay
        at 26 (where AAudio starts).
    -->
    <style name="Horizon" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
