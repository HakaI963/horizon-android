<?xml version="1.0" encoding="utf-8"?>
<!--
    The activity is Horizon's own subclass of the platform's NativeActivity: it
    creates the ANativeWindow the Vulkan swapchain presents to, loads
    libhorizon_android.so by name, and hosts the one invisible EditText that gives
    the phone's keyboard something to type into. There is no engine code in Java.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Reading a resource set the user copied onto the device. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!--
        Predictive back is the default for an app that targets SDK 35, and it takes the
        back button away from the game: android-activity registers no
        OnBackInvokedCallback, so the system would finish the activity instead of ever
        delivering AKEYCODE_BACK. Opting out keeps the key, which the engine then says
        as Escape.
    -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Horizon">
        <!--
            The game is landscape, as it is on a desktop. `sensorLandscape` lets the
            phone turn either way; `configChanges` below keeps the swapchain alive
            through that turn instead of recreating the activity.
        -->
        <activity
            android:name="dev.horizon.android.HorizonActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density|navigation|layoutDirection|locale|fontScale"
            android:exported="true"
            android:keepScreenOn="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Horizon"
            android:windowSoftInputMode="adjustResize">
            <!--
                The keyboard shortens the window rather than covering the game, so the
                engine's text screens lay out above it. Without a mode the system picks
                adjustPan, which has nothing to pan for: the focused view is a 1x1 field
                in the corner, so the keyboard would cover the bottom of the game.
            -->
            <!-- The engine library NativeActivity loads; it exports android_main. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="horizon_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
